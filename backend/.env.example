# Optional overrides (defaults work for local dev)
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost,http://127.0.0.1
# PROCESSED_MAX_DIMENSION=200
# RESIZE_WORKER_COUNT=4

# Photo library root (default: <repo>/workspace — sibling to backend/ and frontend/)
# WORKSPACE_ROOT=/absolute/path/to/workspace

# Vision model for AI image analysis (API key is stored in workspace via Settings UI)
# OPENAI_MODEL=gpt-4o-mini
